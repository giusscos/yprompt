/* Siri and Spotlight phrases for yPrompt's App Shortcuts */
"Start reading ${script} in ${applicationName}" = "Mulai baca ${script} di ${applicationName}";
"Start the teleprompter in ${applicationName}" = "Mulai teleprompter di ${applicationName}";
"Record ${script} with ${applicationName}" = "Rekam ${script} dengan ${applicationName}";
"Record a take in ${applicationName}" = "Rekam take di ${applicationName}";
"Write a script with ${applicationName}" = "Tulis naskah dengan ${applicationName}";
"Open ${target} in ${applicationName}" = "Buka ${target} di ${applicationName}";
