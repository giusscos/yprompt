/* Siri and Spotlight phrases for yPrompt's App Shortcuts */
"Start reading ${script} in ${applicationName}" = "Czytaj ${script} w ${applicationName}";
"Start the teleprompter in ${applicationName}" = "Uruchom prompter w ${applicationName}";
"Record ${script} with ${applicationName}" = "Nagraj ${script} w ${applicationName}";
"Record a take in ${applicationName}" = "Nagraj ujęcie w ${applicationName}";
"Write a script with ${applicationName}" = "Napisz skrypt w ${applicationName}";
"Open ${target} in ${applicationName}" = "Otwórz ${target} w ${applicationName}";
