/* Siri and Spotlight phrases for yPrompt's App Shortcuts */
"Start reading ${script} in ${applicationName}" = "Bắt đầu đọc ${script} trong ${applicationName}";
"Start the teleprompter in ${applicationName}" = "Mở máy nhắc chữ trong ${applicationName}";
"Record ${script} with ${applicationName}" = "Ghi ${script} bằng ${applicationName}";
"Record a take in ${applicationName}" = "Ghi một đoạn trong ${applicationName}";
"Write a script with ${applicationName}" = "Viết kịch bản bằng ${applicationName}";
"Open ${target} in ${applicationName}" = "Mở ${target} trong ${applicationName}";
