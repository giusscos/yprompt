/* Siri and Spotlight phrases for yPrompt's App Shortcuts */
"Start reading ${script} in ${applicationName}" = "ابدأ قراءة ${script} في ${applicationName}";
"Start the teleprompter in ${applicationName}" = "شغّل الملقّن في ${applicationName}";
"Record ${script} with ${applicationName}" = "سجّل ${script} باستخدام ${applicationName}";
"Record a take in ${applicationName}" = "سجّل لقطة في ${applicationName}";
"Write a script with ${applicationName}" = "اكتب نصًا باستخدام ${applicationName}";
"Open ${target} in ${applicationName}" = "افتح ${target} في ${applicationName}";
