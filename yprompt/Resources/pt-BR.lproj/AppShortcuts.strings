/* Siri and Spotlight phrases for yPrompt's App Shortcuts */
"Start reading ${script} in ${applicationName}" = "Comece a ler ${script} no ${applicationName}";
"Start the teleprompter in ${applicationName}" = "Abra o teleprompter no ${applicationName}";
"Record ${script} with ${applicationName}" = "Grave ${script} com o ${applicationName}";
"Record a take in ${applicationName}" = "Grave um take no ${applicationName}";
"Write a script with ${applicationName}" = "Escreva um roteiro com o ${applicationName}";
"Open ${target} in ${applicationName}" = "Abra ${target} no ${applicationName}";
