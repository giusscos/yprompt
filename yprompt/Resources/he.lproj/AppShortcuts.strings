/* Siri and Spotlight phrases for yPrompt's App Shortcuts */
"Start reading ${script} in ${applicationName}" = "התחל לקרוא את ${script} ב־${applicationName}";
"Start the teleprompter in ${applicationName}" = "הפעל את הטלפרומפטר ב־${applicationName}";
"Record ${script} with ${applicationName}" = "הקלט את ${script} עם ${applicationName}";
"Record a take in ${applicationName}" = "הקלט טייק ב־${applicationName}";
"Write a script with ${applicationName}" = "כתוב תסריט עם ${applicationName}";
"Open ${target} in ${applicationName}" = "פתח את ${target} ב־${applicationName}";
