/* Siri and Spotlight phrases for yPrompt's App Shortcuts */
"Start reading ${script} in ${applicationName}" = "Empieza a leer ${script} en ${applicationName}";
"Start the teleprompter in ${applicationName}" = "Abre el teleprompter en ${applicationName}";
"Record ${script} with ${applicationName}" = "Graba ${script} con ${applicationName}";
"Record a take in ${applicationName}" = "Graba una toma en ${applicationName}";
"Write a script with ${applicationName}" = "Escribe un guion con ${applicationName}";
"Open ${target} in ${applicationName}" = "Abre ${target} en ${applicationName}";
